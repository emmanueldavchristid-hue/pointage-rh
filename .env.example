# Copier ce fichier en .env puis remplacer TOUTES les valeurs (ne jamais committer .env)
# Générer des secrets : openssl rand -base64 48   (ou un gestionnaire de mots de passe)
DB_PASSWORD=remplacer-par-un-mot-de-passe-long
JWT_SECRET=remplacer-par-une-chaine-aleatoire-de-48-caracteres-minimum
QR_SECRET=remplacer-par-une-autre-chaine-aleatoire-de-48-caracteres
# Adresse IP FIXE du serveur sur le réseau local (réservation DHCP sur la box/routeur)
SERVER_IP=192.168.1.50
# Nom local optionnel (à déclarer dans le DNS du routeur), inclus dans le certificat
SERVER_NAME=pointage.entreprise.lan
PUBLIC_URL=https://192.168.1.50
# Compte super administrateur créé à l'installation (changement obligatoire à la 1re connexion)
ADMIN_LOGIN=admin
ADMIN_INITIAL_PASSWORD=ChangezMoi2026
# Dossier hôte des sauvegardes (idéalement un second disque ou un disque externe)
BACKUP_HOST_DIR=./deploy/backups
